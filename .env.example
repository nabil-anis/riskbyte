# Generate each token with:  python -c "import secrets;print(secrets.token_urlsafe(32))"
RISKBYTE_ADMIN_TOKEN=
RISKBYTE_ANALYST_TOKEN=
RISKBYTE_INGEST_TOKEN=
# --- Triage model: pick ONE provider. Leave unset for heuristic-only triage. ---
# Local, nothing leaves your network (run: docker compose --profile local up -d):
# RISKBYTE_LLM_PROVIDER=ollama
# RISKBYTE_LLM_URL=http://ollama:11434
# RISKBYTE_LLM_MODEL=llama3.1:8b
#
# Cloud: alert data is sent to the provider. Hosts, users and private IPs are pseudonymized by default.
# RISKBYTE_LLM_PROVIDER=openai          # or gemini
# RISKBYTE_LLM_API_KEY=                 # paste your key here, or use RISKBYTE_LLM_API_KEY_FILE=/run/secrets/llm_key
# RISKBYTE_LLM_MODEL=                   # optional; defaults: gpt-4o-mini / gemini-2.0-flash. Check the provider's docs for current names.
# RISKBYTE_LLM_REDACT=1                 # default on for cloud; set 0 to send real names
# dry_run records what would happen. webhook signs and POSTs approved actions to your SOAR/firewall automation.
RISKBYTE_RESPONSE_MODE=dry_run
# RISKBYTE_RESPONSE_WEBHOOK=https://soar.internal/hooks/riskbyte
# RISKBYTE_RESPONSE_SECRET=
# RISKBYTE_PROTECTED_IPS=203.0.113.0/24
RISKBYTE_RETENTION_DAYS=30
